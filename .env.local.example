# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# Public URL of the chat Worker, used by the static frontend.
# Local development: http://127.0.0.1:8787/api/chat
NEXT_PUBLIC_CHAT_API_URL=http://127.0.0.1:8787/api/chat
